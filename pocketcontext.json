  "timeoutMs": 2000,
  "maxRows": 500,
  "maxBytes": 1048576,
  "snapshot": {
    "filters": {
      "user_directory": "id = :requester OR EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "parties": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "billing_accounts": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "documents": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester) OR documents.owner = :requester",
      "bills": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "bill_lines": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "payments": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "payment_allocations": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "subscriptions": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "claims": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester) OR claims.owner = :requester",
      "claim_reimbursements": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester) OR EXISTS (SELECT 1 FROM claims c WHERE c.id = claim_reimbursements.claim AND c.owner = :requester)",
      "import_batches": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "export_batches": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester)",
      "audit_log": "EXISTS (SELECT 1 FROM finance_members f WHERE f.account = :requester) OR owner = :requester"
    },
    "policyTables": {
      "finance_members": [
        "account",
        "can_approve"
      ]
    },
    "timeoutMs": 5000,
    "maxRows": 100000,
    "maxBytes": 16777216,
    "maxConcurrent": 4
  }
}
